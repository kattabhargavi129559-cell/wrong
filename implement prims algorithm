#include <bits/stdc++.h>
using namespace std;
const int INF = 1e9;
const int N = 1e5 + 5;
vector<pair<int, int>> g[N]; // adjacency list: {neighbor, weight}
int dis[N]; // minimum edge weight to connect vertex
int n, m;
int prim(int start) {
   int totalWeight = 0;
   vector<bool> inMST(n + 1, false);
   for (int i = 1; i <= n; i++) dis[i] = INF;
   priority_queue<pair<int, int>, vector<pair<int, int>>, greater<>> pq;
   dis[start] = 0;
   pq.push({0, start});
   while (!pq.empty()) {
       auto [curDist, u] = pq.top();
       pq.pop();
       if (inMST[u]) continue;
       inMST[u] = true;
       totalWeight += curDist;
       for (auto &[v, w] : g[u]) {
           if (!inMST[v] && w < dis[v]) {
               dis[v] = w;
               pq.push({dis[v], v});
           }
       }
   }
   return totalWeight;
}
int main() {
   ios::sync_with_stdio(false);
   cin.tie(nullptr);
   cin >> n >> m;
   for (int i = 0; i < m; i++) {
       int u, v, w;
       cin >> u >> v >> w;
       g[u].push_back({v, w});
       g[v].push_back({u, w});
   }
   cout << prim(1) << "\n";
}
